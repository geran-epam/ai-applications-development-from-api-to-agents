{
  "info": {
    "name": "dial-ai-course-fixed",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "OpenRouter examples using OpenAI-compatible and Anthropic-compatible REST APIs."
  },
  "item": [
    {
      "name": "1. LLMs API collection",
      "item": [
        {
          "name": "openai",
          "item": [
            {
              "name": "OpenAI Chat Completions via OpenRouter",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{OPENROUTER_API_KEY}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"{{OPENAI_MODEL}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Behave as a pirate!\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Ahoy there, matey! What be yer business on these seas today?\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"what can you do?\"\n    }\n  ],\n  \"stream\": false\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "https://openrouter.ai/api/v1/chat/completions",
                  "protocol": "https",
                  "host": [
                    "openrouter",
                    "ai"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "chat",
                    "completions"
                  ]
                },
                "description": "OpenAI-compatible Chat Completions request routed through OpenRouter."
              },
              "response": []
            },
            {
              "name": "OpenAI Responses via OpenRouter",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{OPENROUTER_API_KEY}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"{{OPENAI_MODEL}}\",\n  \"instructions\": \"Behave as a pirate!\",\n  \"input\": \"What can you do?\",\n  \"stream\": false\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "https://openrouter.ai/api/v1/responses",
                  "protocol": "https",
                  "host": [
                    "openrouter",
                    "ai"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "responses"
                  ]
                },
                "description": "OpenRouter Responses API example. Model support for this endpoint can vary."
              },
              "response": []
            }
          ]
        },
        {
          "name": "anthropic",
          "item": [
            {
              "name": "Claude via OpenRouter Anthropic Messages API",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{OPENROUTER_API_KEY}}",
                    "type": "text"
                  },
                  {
                    "key": "anthropic-version",
                    "value": "2023-06-01",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"{{ANTHROPIC_MODEL}}\",\n  \"system\": \"Behave as a pirate!\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Ahoy there, matey! What be yer business on these seas today?\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"what can you do?\"\n    }\n  ],\n  \"max_tokens\": 1024,\n  \"stream\": false\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "https://openrouter.ai/api/v1/messages",
                  "protocol": "https",
                  "host": [
                    "openrouter",
                    "ai"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "messages"
                  ]
                },
                "description": "Claude request using OpenRouter's Anthropic Messages API compatibility endpoint."
              },
              "response": []
            }
          ]
        },
        {
          "name": "gemini",
          "item": [
            {
              "name": "Gemini Flash via OpenRouter",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{OPENROUTER_API_KEY}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"{{GEMINI_MODEL}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Behave as a pirate!\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Ahoy there, matey! What be yer business on these seas today?\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"what can you do?\"\n    }\n  ],\n  \"stream\": false\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "https://openrouter.ai/api/v1/chat/completions",
                  "protocol": "https",
                  "host": [
                    "openrouter",
                    "ai"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "chat",
                    "completions"
                  ]
                },
                "description": "Gemini request using OpenRouter's OpenAI-compatible Chat Completions API."
              },
              "response": []
            },
            {
              "name": "Gemini Flash Streaming via OpenRouter",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{OPENROUTER_API_KEY}}",
                    "type": "text"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
                    "key": "Accept",
                    "value": "text/event-stream",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"{{GEMINI_MODEL}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Behave as a pirate!\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"hi\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"Ahoy there, matey! What be yer business on these seas today?\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"what can you do?\"\n    }\n  ],\n  \"stream\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "https://openrouter.ai/api/v1/chat/completions",
                  "protocol": "https",
                  "host": [
                    "openrouter",
                    "ai"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "chat",
                    "completions"
                  ]
                },
                "description": "Streaming Gemini request delivered as Server-Sent Events."
              },
              "response": []
            }
          ]
        },
        {
          "name": "utility",
          "item": [
            {
              "name": "List OpenRouter Models",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{OPENROUTER_API_KEY}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "https://openrouter.ai/api/v1/models",
                  "protocol": "https",
                  "host": [
                    "openrouter",
                    "ai"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "models"
                  ]
                },
                "description": "Lists available OpenRouter models and their exact model IDs."
              },
              "response": []
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "OPENAI_MODEL",
      "value": "openai/gpt-4o-mini",
      "type": "string"
    },
    {
      "key": "ANTHROPIC_MODEL",
      "value": "anthropic/claude-3.5-sonnet",
      "type": "string"
    },
    {
      "key": "GEMINI_MODEL",
      "value": "google/gemini-2.5-flash",
      "type": "string"
    }
  ]
}